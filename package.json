{
  "name": "meituan-cli",
  "version": "0.1.5",
  "description": "Order Meituan takeout (美团外卖) from the terminal. Built for AI agents: terse output, real checkout prices, the user pays on their phone.",
  "keywords": [
    "meituan",
    "美团",
    "美团外卖",
    "waimai",
    "takeout",
    "food-delivery",
    "cli",
    "ai-agent",
    "agent-tools"
  ],
  "homepage": "https://github.com/Mergemat/meituan-cli#readme",
  "bugs": "https://github.com/Mergemat/meituan-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mergemat/meituan-cli.git"
  },
  "license": "MIT",
  "author": "Baga <baga@omarov.sh>",
  "type": "module",
  "bin": {
    "meituan-cli": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "bench": "bun scripts/measure.ts bench",
    "build": "bun build src/cli.ts --compile --minify --outfile dist/meituan-cli",
    "build:npm": "bun build src/cli.ts --target=node --minify --banner '#!/usr/bin/env node' --outfile dist/cli.js",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "link": "bun run build && ln -sf \"$PWD/dist/meituan-cli\" ~/.local/bin/meituan-cli",
    "meituan-cli": "bun src/cli.ts",
    "prepublishOnly": "bun test && bun run build:npm",
    "scan": "bun scripts/scan.ts",
    "score": "bun scripts/measure.ts log",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "latest",
    "gpt-tokenizer": "latest",
    "typescript": "^5",
    "ultracite": "8.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
